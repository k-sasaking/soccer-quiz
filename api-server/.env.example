# api-server/.env のひな形。コピーして .env を作り、Neon の接続文字列を入れる。
# Neon のダッシュボード → Connect からコピーできる（または `neon connection-string --project-id <id>`）。
# DATABASE_URL  … アプリ（Prisma Client）が使う。接続プーラー経由（ホスト名に -pooler が付くもの）
# DIRECT_URL    … Prisma CLI（migrate / db push）が使う。プーラーを通さない直接接続
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

# ログイン（next-auth）の設定
# NEXTAUTH_SECRET … ログイン状態（Cookie の JWT）の署名・暗号化に使う鍵。`openssl rand -base64 32` で作る。漏れたら作り直す
# NEXTAUTH_URL    … このサーバーの URL。本番では https:// の URL を必ず指定する
NEXTAUTH_SECRET="ここに openssl rand -base64 32 の結果を入れる"
NEXTAUTH_URL="http://localhost:3000"
